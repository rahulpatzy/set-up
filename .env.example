# ── How to use ────────────────────────────────────────────────────────────────
# Create one file per environment (all git-ignored):
#   .env.development  ← local dev
#   .env.qa           ← QA config
#   .env.production   ← prod config
#
# Switch with:  make env-dev | make env-qa | make env-prod
# (copies the chosen file to .env, which the app reads)

# ── Backend ───────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ENVIRONMENT=development   # development | qa | production

# ── Frontend ──────────────────────────────────────────────────────────────────
# Vite exposes vars prefixed with VITE_ to the browser bundle.

VITE_API_URL=http://localhost:8000
